  "power_modes": {
    "powersave": {
      "cpu.max_power": {
        "if cpuTemp > 90": 2000,
        "else": 4000
      },
      "devfreq.gpu.max_freq": {
        "if cpuTemp > 90": 500,
        "else": 600
      }
    },
    "balance": {
      "cpu.max_power": {
        "if cpuTemp > 90": 2000,
        "if cpuTemp > 85": 6000,
        "else": 8000
      },
      "devfreq.gpu.max_freq": {
        "if cpuTemp > 90": 500,
        "if cpuTemp > 85": 650,
        "else": 700
      }
    },
    "performance": {
      "cpu.max_power": {
        "if cpuTemp > 90": 2000,
        "if cpuTemp > 85": 6000,
        "if cpuTemp > 80": 9000,
        "else": 10000
      },
      "devfreq.gpu.max_freq": {
        "if cpuTemp > 90": 500,
        "if cpuTemp > 85": 650,
        "if cpuTemp > 80": 750,
        "else": 800
      }
    },
    "fast": {
      "cpu.max_power": 10000,
      "devfreq.gpu.max_freq": 1000
    }
